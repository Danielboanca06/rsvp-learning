DATABASE_URL="file:./dev.db"

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- LLM backend selection ---
# "ollama": local Ollama instance, free, no external account needed. Default —
#   safe for local dev, matches current behavior, never gates on quota/credits.
# "direct": calls each provider directly with an in-process fallback loop
#   (lib/llm.ts's MODEL_GROUPS) across the free/paid providers below. No extra
#   hosting required — this runs inline in the app's own server code.
LLM_BACKEND=ollama
OLLAMA_BASE_URL="http://localhost:11434"

# --- Free-tier provider pool (lib/llm.ts's MODEL_GROUPS routes to these) ---
# Every one of these requires creating a free account with the provider —
# something only you can do; the app can't sign up on your behalf. No credit
# card is required for any of these as of the Phase 0 research.
OPENROUTER_API_KEY=      # https://openrouter.ai/keys — several distinct :free model IDs
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
GROQ_API_KEY=            # https://console.groq.com/keys
CEREBRAS_API_KEY=        # https://cloud.cerebras.ai

# --- Paid-tier provider (used for Pro users' calls) ---
ANTHROPIC_API_KEY=       # https://console.anthropic.com/settings/keys

# --- Stripe (billing/credit ledger — app/api/billing, app/api/webhooks/stripe) ---
# Requires a Stripe account: https://dashboard.stripe.com/register
# Use test-mode keys (sk_test_/pk_test_) until you're ready to go live.
STRIPE_SECRET_KEY=
# From the Stripe CLI (`stripe listen --forward-to localhost:3000/api/webhooks/stripe`)
# for local dev, or the dashboard's webhook endpoint config in production.
STRIPE_WEBHOOK_SECRET=
# Price IDs created in the Stripe dashboard (Products) — one recurring price for
# the Pro subscription, two one-time prices for credit top-up packs. See
# lib/stripe.ts's CHECKOUT_PRODUCTS for what each grants.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_TOPUP_SMALL=
STRIPE_PRICE_TOPUP_LARGE=

NEXT_PUBLIC_APP_URL="http://localhost:3000"
