generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Document {
  id          String     @id @default(cuid())
  userId      String
  title       String
  // "upload" (user-provided text/PDF) | "generated" (AI course module content).
  // Generated documents live in their course's Space so every existing surface
  // (read flow, quizzes, FSRS review, daily quiz, analytics) works unchanged.
  sourceType  String     @default("upload")
  createdAt   DateTime   @default(now())
  startingWpm Int        @default(250)
  spaceId     String
  space       Space      @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  chunks      Chunk[]
  sessions    Session[]
  quizzes     Quiz[]
  courseModule CourseModule?

  @@index([userId])
  @@index([spaceId])
}

// --- AI course generation ---
// A Course is a learner-goal-driven syllabus whose modules are generated lazily
// into ordinary Documents (sourceType "generated") inside a dedicated Space, so
// the entire existing learning loop applies to generated content unchanged.

model Course {
  id           String   @id @default(cuid())
  userId       String
  spaceId      String // dedicated Space created per course
  title        String
  goal         String // learner's stated objective
  learnerBrief Json // intake answers: level, time budget, motivation, interests
  status       String   @default("draft") // draft | active | completed | archived
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  modules      CourseModule[]

  @@index([userId, status])
}

model CourseModule {
  id          String    @id @default(cuid())
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order       Int
  title       String
  objectives  Json // string[] learning objectives (Bloom verbs)
  summary     String // 1-2 sentence syllabus description
  status      String    @default("locked") // locked | unlocked | generating | ready | completed | failed
  documentId  String?   @unique // set once generated; content lives in existing Document/Chunk
  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  generatedAt DateTime?

  @@unique([courseId, order])
  @@index([courseId])
}

model Space {
  id        String     @id @default(cuid())
  userId    String
  name      String
  isDefault Boolean    @default(false)
  createdAt DateTime   @default(now())
  documents Document[]
  quizzes   Quiz[]

  @@index([userId, isDefault])
  @@index([createdAt])
}

model Chunk {
  id         String     @id @default(cuid())
  documentId String
  document   Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  order      Int
  title      String
  content    String
  wordCount  Int
  // Parent section of the learning path this sub-module belongs to; null for
  // documents chunked before sections existed and for fallback chunking.
  sectionTitle String?
  // Pre-generated recall anchors (string[], 3-5 one-idea sentences).
  keyPoints    Json?
  attempts   Attempt[]

  // Spaced-repetition scheduling (FSRS-6)
  stability      Float?
  difficulty     Float?
  dueAt          DateTime?
  lastReviewedAt DateTime?
  reviewState    String    @default("new") // new | learning | review | relearning
  reps           Int       @default(0)
  lapses         Int       @default(0)

  // Quiz tracking
  quizWrongCount Int            @default(0)
  quizQuestions  QuizQuestion[]

  @@index([documentId, order])
  @@index([dueAt])
}

model Session {
  id          String     @id @default(cuid())
  userId      String
  documentId  String?
  document    Document?  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  type        String     @default("study") // study | review
  startedAt   DateTime   @default(now())
  completedAt DateTime?
  currentWpm  Int
  status      String     @default("active")
  attempts    Attempt[]

  @@index([userId])
  @@index([documentId])
}

model Attempt {
  id               String   @id @default(cuid())
  sessionId        String
  session          Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  chunkId          String
  chunk            Chunk    @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  summary          String
  score            Int
  hint             String
  socraticQuestion String?
  wpmAtAttempt     Int
  passed           Boolean
  createdAt        DateTime @default(now())

  @@index([sessionId])
  @@index([chunkId])
}

model PointsEvent {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String   // chunk_passed | review_passed | word_recalled
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model VocabularyWord {
  id             String    @id @default(cuid())
  userId         String
  word           String
  definition     String
  documentId     String?
  chunkId        String?
  createdAt      DateTime  @default(now())
  lastRecalledAt DateTime?
  recallCount    Int       @default(0)

  @@unique([userId, word])
  @@index([userId])
  @@index([createdAt])
  @@index([lastRecalledAt])
}

model Quiz {
  id             String     @id @default(cuid())
  userId         String
  kind           String     // "module" | "daily"
  documentId     String?
  document       Document?  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  spaceId        String?
  space          Space?     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  status         String     @default("active") // active | completed
  totalQuestions Int
  score          Int        @default(0)
  createdAt      DateTime   @default(now())
  completedAt    DateTime?
  items          QuizItem[]

  @@index([userId])
  @@index([documentId])
  @@index([kind, createdAt])
  @@index([spaceId, kind, status])
}

model QuizItem {
  id             String       @id @default(cuid())
  quizId         String
  quiz           Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizQuestionId String
  quizQuestion   QuizQuestion @relation(fields: [quizQuestionId], references: [id], onDelete: Cascade)
  order          Int
  selectedIndex  Int?
  correct        Boolean?
  answeredAt     DateTime?

  @@index([quizId])
}

model QuizQuestion {
  id           String     @id @default(cuid())
  chunkId      String
  chunk        Chunk      @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  question     String
  options      Json       // string[4]
  correctIndex Int
  createdAt    DateTime   @default(now())
  items        QuizItem[]

  @@index([chunkId])
}

// --- AI chat platform ---
// App-wide conversation store, deliberately generic: any surface (selection
// Q&A in the reader, future dashboard copilot, ...) creates a ChatThread with
// whatever context anchors it needs. Sub-discussions (e.g. "practice
// understanding" exercises) are child threads via parentThreadId, so they hang
// off a document section rather than living inside the parent conversation.

model ChatThread {
  id     String @id @default(cuid())
  userId String
  // Surface that owns the thread: "selection" (Ask AI on a highlighted passage)
  // | "practice" (child thread where the user writes their own summary).
  // New surfaces add kinds without schema changes.
  kind   String
  title  String

  // Context anchors — all optional so the model stays surface-agnostic.
  documentId    String?
  chunkId       String?
  selectionText String?

  parentThreadId String?
  parent         ChatThread?  @relation("ThreadChildren", fields: [parentThreadId], references: [id], onDelete: Cascade)
  children       ChatThread[] @relation("ThreadChildren")

  status    String   @default("active") // active | archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@index([documentId, chunkId])
  @@index([parentThreadId])
}

model ChatMessage {
  id       String     @id @default(cuid())
  threadId String
  thread   ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role     String // user | assistant
  // Ordered array of typed message parts (see lib/chat/protocol.ts). Text and
  // tool activity today; diagrams/charts/citations/cards later — renderers skip
  // part types they don't know, so new types need no migration.
  parts    Json
  status   String     @default("complete") // complete | failed
  createdAt DateTime  @default(now())

  @@index([threadId, createdAt])
}

// --- LLM gateway billing/usage ledger ---
// Postgres is used in every non-local environment; app DB stays on SQLite locally
// for now (see litellm-gateway-plan). Provider-facing rate limits are per API key,
// not per user, so every one of these models exists to enforce OUR per-user
// rationing independent of whatever the providers report.

model UserPlan {
  userId               String    @id
  plan                 String    @default("free") // free | trial | pro
  // Reverse trial: set at first sign-in, checked lazily in getUserTier — an
  // expired trial resolves to "free" with no cron needed.
  trialEndsAt          DateTime?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([plan])
}

model FreeQuotaCounter {
  userId      String   @id
  periodStart DateTime
  count       Int      @default(0)

  @@index([periodStart])
}

model UserCredits {
  userId  String @id
  balance Int    @default(0)
}

model CreditLedger {
  id            String   @id @default(cuid())
  userId        String
  deltaCredits  Int      // positive = granted/purchased, negative = spent
  reason        String   // stripe_subscription_grant | stripe_topup | llm_spend | refund
  realCostUsd   Float?   // set on spend rows, from LiteLLM's reported cost
  stripeEventId String?  @unique // idempotency guard against webhook replay
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

model LlmUsageEvent {
  id             String   @id @default(cuid())
  userId         String
  task           String   // chunking | grading | quizgen | chat | coursegen_syllabus | coursegen_module
  tier           String   // free | paid
  servedModel    String   // actual model LiteLLM routed to
  success        Boolean
  tokensIn       Int?
  tokensOut      Int?
  realCostUsd    Float?
  latencyMs      Int?
  // Credits deducted for this call (paid tier only) so revenue-vs-cost per task
  // is a single aggregate query.
  creditsCharged Int?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([task, createdAt])
}

model EmailPreference {
  userId     String    @id
  enabled    Boolean   @default(true)
  lastSentAt DateTime?
}
